DATABASE_URL="postgresql://frete:frete@localhost:5434/frete"
SESSION_SECRET="troque-por-um-segredo-com-no-minimo-32-caracteres"
NODE_ENV="development"
DATABASE_URL_TEST="postgresql://frete:frete@localhost:5433/frete_test"

# Confia em cabeçalhos de IP definidos por proxy (x-real-ip, x-forwarded-for)
# para o rate limit por IP. Só ligue isto atrás de um proxy/load balancer
# confiável que sobrescreve esses cabeçalhos — caso contrário, o cliente
# pode forjá-los e contornar o rate limit por IP. Padrão: false.
TRUST_PROXY_HEADERS="false"
