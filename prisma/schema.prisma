generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUser {
  PF
  PJ
}

enum PapelUser {
  CLIENTE
  ADMIN
}

enum TipoEndereco {
  REMETENTE
  DESTINATARIO
}

enum StatusShipment {
  PENDING
  RELEASED
  GENERATED
  POSTED
  DELIVERED
  CANCELLED
  LOST
}

enum TipoLedger {
  CREDITO
  DEBITO
}

enum CenarioSimulacao {
  ENTREGA_NORMAL
  ATRASO
  TENTATIVA_FALHA
  EXTRAVIO
  DEVOLUCAO
}

enum MetodoPagamento {
  PIX
  CARTAO
}

enum StatusPagamento {
  PENDENTE
  CONFIRMADO
  EXPIRADO
  CANCELADO
}

enum AmbienteApiToken {
  SANDBOX
  PRODUCAO
}

model User {
  id                String    @id @default(cuid())
  tipo              TipoUser
  papel             PapelUser @default(CLIENTE)
  documento         String    @unique
  nome              String
  email             String    @unique
  senhaHash         String
  telefone          String?
  emailVerificadoEm DateTime?
  cepOrigemPadrao   String?
  criadoEm          DateTime  @default(now())

  sessions         Session[]
  addresses        Address[]
  quotes           Quote[]
  shipments        Shipment[]
  wallet           Wallet?
  paymentIntents   PaymentIntent[]
  webhookApps      WebhookApp[]
  statusRastreios  StatusRastreio[]
  rastreioTemplate RastreioTemplate?
  apiTokens        ApiToken[]
  emailConfig      EmailConfig?
  emailDeliveries  EmailDelivery[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiraEm  DateTime
  userAgent String?
  ip        String?
  criadoEm  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AnonSession {
  id          String    @id @default(uuid())
  criadoEm    DateTime  @default(now())
  consumidaEm DateTime?

  quotes Quote[]

  @@map("anon_sessions")
}

model Address {
  id          String       @id @default(cuid())
  userId      String
  apelido     String?
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String
  latitude    Float?
  longitude   Float?
  tipo        TipoEndereco
  padrao      Boolean      @default(false)
  documento   String?
  nome        String?
  email       String?
  telefone    String?
  criadoEm    DateTime     @default(now())
  arquivadoEm DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Carrier {
  id       String   @id @default(cuid())
  nome     String
  slug     String   @unique
  ativo    Boolean  @default(true)
  logoUrl  String?
  criadoEm DateTime @default(now())

  services Service[]

  @@map("carriers")
}

model Service {
  id              String   @id @default(cuid())
  carrierId       String
  codigo          String
  nome            String
  prazoBase       Int
  exigePudo       Boolean  @default(false)
  entregaSabado   Boolean  @default(false)
  limitePesoG     Int
  limiteDimensoes Json
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())

  carrier    Carrier     @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  priceRules PriceRule[]
  quotes     Quote[]
  shipments  Shipment[]

  @@unique([carrierId, codigo])
  @@map("services")
}

model PriceRule {
  id                  String    @id @default(cuid())
  serviceId           String
  cepOrigemIni        Int
  cepOrigemFim        Int
  cepDestinoIni       Int
  cepDestinoFim       Int
  pesoMinG            Int
  pesoMaxG            Int
  precoBalcaoCentavos Int
  precoCustoCentavos  Int
  precoVendaCentavos  Int
  prazoDias           Int
  ativo               Boolean   @default(true)
  vigenteDe           DateTime  @default(now())
  vigenteAte          DateTime?
  criadoEm            DateTime  @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, cepOrigemIni, cepDestinoIni, pesoMinG])
  @@map("price_rules")
}

model Quote {
  id            String   @id @default(cuid())
  userId        String?
  anonSessionId String?
  serviceId     String?
  cepOrigem     String
  cepDestino    String
  formato       String
  pesoG         Int
  altura        Int
  largura       Int
  comprimento   Int
  diametro      Int?
  pesoCubadoG   Int
  pesoTaxavelG  Int
  opcionais     Json
  opcoes        Json
  expiraEm      DateTime
  criadoEm      DateTime @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonSession AnonSession? @relation(fields: [anonSessionId], references: [id], onDelete: SetNull)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  shipments   Shipment[]

  @@index([userId])
  @@index([anonSessionId])
  @@map("quotes")
}

model Shipment {
  id                     String           @id @default(cuid())
  userId                 String
  quoteId                String?
  serviceId              String
  codigoRastreio         String?          @unique
  status                 StatusShipment   @default(PENDING)
  remetente              Json
  destinatario           Json
  pontoPostagemId        String?
  precoBalcaoCentavos    Int
  precoCobradoCentavos   Int
  descontoCentavos       Int
  opcionais              Json
  valorDeclaradoCentavos Int
  produtos               Json
  labelUrl               String?
  dceNumero              String?
  /**
   * `true` para envios criados por um `ApiToken` de ambiente SANDBOX pela
   * API pública (`/api/v0`). Isola o teste do lojista do dinheiro real: o
   * pagamento de um envio sandbox nunca toca a `Wallet` nem dispara a
   * emissão de etiqueta real — ver `src/server/api-publica-service.ts`.
   */
  sandbox                Boolean          @default(false)
  cenario                CenarioSimulacao @default(ENTREGA_NORMAL)
  simulacaoIniciadaEm    DateTime?
  fatorSimulacao         Int              @default(1)
  criadoEm               DateTime         @default(now())
  pagoEm                 DateTime?
  geradoEm               DateTime?
  postadoEm              DateTime?
  entregueEm             DateTime?
  devolvidoEm            DateTime?
  canceladoEm            DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  quote          Quote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  trackingEvents TrackingEvent[]

  @@index([userId, status])
  @@map("shipments")
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  saldoCentavos Int      @default(0)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@map("wallets")
}

model LedgerEntry {
  id                String     @id @default(cuid())
  walletId          String
  tipo              TipoLedger
  valorCentavos     Int
  saldoAposCentavos Int
  refTipo           String
  refId             String
  descricao         String
  criadoEm          DateTime   @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([refTipo, refId, tipo])
  @@index([walletId, criadoEm])
  @@map("ledger_entries")
}

model PaymentIntent {
  id            String          @id @default(cuid())
  userId        String
  valorCentavos Int
  metodo        MetodoPagamento
  status        StatusPagamento @default(PENDENTE)
  qrCode        String?
  expiraEm      DateTime
  confirmadoEm  DateTime?
  criadoEm      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("payment_intents")
}

model TrackingEvent {
  id             String   @id @default(cuid())
  shipmentId     String
  sequencia      Int
  offsetMinutos  Int
  codigo         String
  status         String
  titulo         String
  descricao      String
  local          String?
  unidadeOrigem  String?
  unidadeDestino String?
  cidade         String
  uf             String
  forcado        Boolean  @default(false)
  ocorridoEm     DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, sequencia])
  @@index([shipmentId, ocorridoEm])
  @@map("tracking_events")
}

/// Registro único de configuração global da simulação de transporte.
/// O fator é copiado para o envio na geração da etiqueta, então alterar
/// aqui só afeta envios novos — ver spec 2026-08-31, seção 2.
model SimulacaoConfig {
  id              String   @id @default("singleton")
  fatorVelocidade Int      @default(1)
  operador        String   @default("DE ENCOMENDAS")
  atualizadoEm    DateTime @updatedAt

  @@map("simulacao_config")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  acao        String
  entidade    String
  entidadeId  String
  antes       Json?
  depois      Json?
  criadoEm    DateTime @default(now())

  @@index([entidade, entidadeId])
  @@map("audit_logs")
}

/// Assinatura de webhook de um cliente: para onde notificar e com que
/// segredo assinar. O segredo é gerado pelo servidor e mostrado uma única
/// vez no cadastro — depois disso só o cliente tem a cópia legível.
model WebhookApp {
  id       String   @id @default(cuid())
  userId   String
  url      String
  eventos  Json
  segredo  String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId, ativo])
  @@map("webhook_apps")
}

/// Uma entrega enfileirada. O payload é congelado no momento do evento: se
/// o envio mudar depois, a notificação continua descrevendo o que de fato
/// aconteceu naquele instante, e não o estado atual.
model WebhookDelivery {
  id                 String    @id @default(cuid())
  webhookAppId       String
  evento             String
  payload            Json
  tentativas         Int       @default(0)
  statusHttp         Int?
  erro               String?
  proximaTentativaEm DateTime?
  entregueEm         DateTime?
  criadoEm           DateTime  @default(now())

  webhookApp WebhookApp @relation(fields: [webhookAppId], references: [id], onDelete: Cascade)

  @@index([proximaTentativaEm, entregueEm])
  @@index([webhookAppId, criadoEm])
  @@map("webhook_deliveries")
}

/// Catálogo de status de rastreio, personalizável por conta.
///
/// `userId` nulo é a linha do catálogo padrão da plataforma. A resolução
/// para um envio sobrepõe o padrão com as linhas do dono, de modo que
/// personalizar uma copy não faz a conta perder as demais.
///
/// `cenario`, `fracaoPrazo` e `statusResultante` só são preenchidos em
/// status criados pelo cliente, que entram no roteiro automático. Um status
/// que apenas reescreve o texto de um código existente deixa os três nulos e
/// não altera a forma da timeline.
model StatusRastreio {
  id               String            @id @default(cuid())
  userId           String?
  codigo           String
  titulo           String
  descricao        String
  cenario          CenarioSimulacao?
  fracaoPrazo      Float?
  diasAposEmissao  Float?
  statusResultante StatusShipment?
  ativo            Boolean           @default(true)
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("status_rastreio")
}

/// Template de percurso do rastreio, montado pela conta.
///
/// Substitui o roteiro automático por cenário nos envios desta conta. Sem
/// template ativo, vale o caminho padrão da simulação.
///
/// `passos` é a lista ordenada de etapas em JSON — a ordem é o dado, e eles
/// são sempre lidos e gravados juntos.
model RastreioTemplate {
  id           String   @id @default(cuid())
  userId       String   @unique
  ativo        Boolean  @default(true)
  passos       Json
  /// Ligações entre nós, por id de instância. Nulo = percurso linear pela
  /// ordem dos passos.
  conexoes     Json?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rastreio_templates")
}

/// Token de acesso à API pública (`/api/v0`), por conta e por ambiente.
///
/// O valor em claro nunca é gravado — só `tokenHash` (SHA-256 hex). O valor
/// em claro é devolvido uma única vez, na criação
/// (`src/server/api-token-service.ts`), e nunca mais reconstruído: nem
/// listagem, nem log, nem mensagem de erro voltam a mostrá-lo.
model ApiToken {
  id          String           @id @default(cuid())
  userId      String
  nome        String
  tokenHash   String           @unique
  ambiente    AmbienteApiToken
  ultimoUsoEm DateTime?
  revogadoEm  DateTime?
  criadoEm    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// Conexão de e-mail da conta. A chave de API fica cifrada; `dicaChave`
/// existe para a tela confirmar qual chave está conectada sem devolvê-la.
model EmailConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  provedor      String   @default("RESEND")
  apiKeyCifrada String
  dicaChave     String
  remetente     String
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_configs")
}

/// Histórico de envios. Sem ele, "o e-mail nao chegou" nao tem como ser
/// investigado.
model EmailDelivery {
  id         String   @id @default(cuid())
  userId     String
  shipmentId String?
  para       String
  assunto    String
  evento     String
  status     String
  erro       String?
  idExterno  String?
  criadoEm   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, criadoEm])
  @@map("email_deliveries")
}
